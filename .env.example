# ==============================================================================
# ResearchMate - Environment Configuration
# IBM watsonx.ai & Granite Model Credentials
# ==============================================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=researchmate-super-secret-key-production-2026

# IBM watsonx.ai Service Credentials (IBM Cloud Lite / Pay-as-you-go)
# 1. Sign up for IBM Cloud Lite at: https://cloud.ibm.com/registration
# 2. Open watsonx.ai console at: https://dataplatform.cloud.ibm.com/
# 3. Create a Project and copy its Project ID (Manage > General > Details)
# 4. Generate an IBM Cloud IAM API Key at: https://cloud.ibm.com/iam/apikeys
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite Model Selection
# Supported models:
# - ibm/granite-13b-chat-v2  (Recommended for deep academic synthesis and reasoning)
# - ibm/granite-3-8b-instruct (Fast, low-latency instruction following)
# - ibm/granite-20b-multilingual (Multilingual paper analysis)
# - ibm/granite-3-2b-instruct (Ultra-lightweight)
IBM_GRANITE_MODEL_ID=ibm/granite-13b-chat-v2

# Storage & Upload limits
MAX_CONTENT_LENGTH=33554432 # 32MB max PDF size
UPLOAD_FOLDER=uploads
EXPORT_FOLDER=exports
DATABASE_URI=sqlite:///researchmate.db
